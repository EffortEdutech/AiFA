# Secrets
.env
.env.*
app/.env
app/.env.*
web/.env
web/.env.*
# ...but .env.example files ARE meant to be committed (they're templates,
# not secrets) -- found this sprint: the blanket .env.* pattern above had
# been silently swallowing app/.env.example since git init (Sprint 15),
# never actually version-controlled despite README/every .env.example
# comment assuming it was shipped in the repo. Fixed here rather than
# left for web/.env.example to repeat the same gap.
!.env.example
!app/.env.example
!web/.env.example

# Dependencies
node_modules/
app/node_modules/

# Graphify generated output
graphify-out/
.graphify-work/

# Logs and build output
.setup-logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.expo/
app/.expo/
app/dist/

# OS/editor noise
.DS_Store
Thumbs.db

# Local Supabase CLI runtime state (Docker/CLI-generated, not project source)
supabase/.branches/
supabase/.temp/
supabase/snippets/

# Node modules recovery folder from Sprint 14 incident - delete manually
_to_delete/
