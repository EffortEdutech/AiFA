# Copy to .env and fill in real values. Never commit .env.
# Same Supabase project as app/.env.example (Vol 12_0 §6 "Same backend for
# both platforms").
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional: where the public site is served from (no trailing slash). Defaults
# to the current Vercel address; set to https://aifa.com when it is attached.
# VITE_PUBLIC_SITE_URL=https://ai-fa-tawny.vercel.app
