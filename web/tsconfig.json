{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@aifa/core/*": ["../packages/core/src/*"],
      "@noble/ciphers/aes.js": ["node_modules/@noble/ciphers/aes.d.ts"],
      "@noble/ciphers/utils.js": ["node_modules/@noble/ciphers/utils.d.ts"],
      "@noble/hashes/hkdf.js": ["node_modules/@noble/hashes/hkdf.d.ts"],
      "@noble/hashes/sha2.js": ["node_modules/@noble/hashes/sha2.d.ts"],
      "@noble/hashes/utils.js": ["node_modules/@noble/hashes/utils.d.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
